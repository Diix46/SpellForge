# Normalize line endings to LF in the repo (matches .editorconfig + ESLint).
* text=auto eol=lf

# Binary files — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# The print fonts of the HD card generator are licensed: encrypted with
# git-crypt, never readable in this public repository (scripts/recompose/README.md).
scripts/recompose/fonts/** filter=git-crypt diff=git-crypt -text
